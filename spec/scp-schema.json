{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikfot/skill-contracts-protocol/spec/scp-schema.json",
  "title": "SCP v1.0 -- Skill Contracts Protocol",
  "description": "JSON Schema for SCP (Skill Contracts Protocol) declarative LLM agent skill contracts.",
  "type": "object",
  "required": ["scp", "name", "description"],
  "properties": {
    "scp": {
      "type": "string",
      "const": "1.0",
      "description": "SCP specification version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Unique skill identifier (kebab-case recommended)."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-line human-readable summary."
    },
    "activation": {
      "$ref": "#/$defs/Activation",
      "description": "Exclusive invocation routes. When absent the skill is always discoverable."
    },
    "delegates_to": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Child skill names this skill may delegate to."
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/InputSpec" },
      "description": "Values the host supplies for args_template placeholders."
    },
    "constraints": {
      "type": "object",
      "description": "The enforcement contract.",
      "properties": {
        "enforcement": {
          "type": "string",
          "enum": ["strict", "soft", "off"],
          "default": "strict",
          "description": "How violations are handled: strict (reject), soft (warn and approve), off (pass-through)."
        },
        "tool_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Tool names the agent may call. If present, calls to unlisted tools are rejected."
        },
        "plan": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanStep" },
          "description": "Ordered steps the agent should execute."
        },
        "evidence": {
          "type": "object",
          "required": ["required"],
          "properties": {
            "required": {
              "type": "array",
              "items": { "$ref": "#/$defs/EvidenceItem" },
              "minItems": 1,
              "description": "Evidence the agent must collect before finalization."
            },
            "detection": {
              "type": "array",
              "items": { "$ref": "#/$defs/EvidenceDetectionRule" },
              "description": "Regex rules that mark evidence as collected from tool outputs."
            }
          },
          "additionalProperties": false
        },
        "finalization": {
          "type": "object",
          "properties": {
            "require_all_evidence": {
              "type": "boolean",
              "default": true,
              "description": "If true, all required evidence must be collected."
            },
            "min_iterations": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Minimum tool-call iterations before finalization."
            }
          },
          "additionalProperties": false
        },
        "tool_overrides": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Alias mapping: legacy tool name -> actual tool name."
        },
        "referenced_content": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReferencedContent" },
          "description": "Named supplementary content blocks the agent can read selectively."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Activation": {
      "type": "object",
      "properties": {
        "triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Keywords for automatic skill selection."
        },
        "slash_command": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit invocation name (e.g. /investigate)."
        },
        "attachment_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Data-driven activation by attachment type."
        },
        "auto_discover": {
          "type": "boolean",
          "default": true,
          "description": "Whether the orchestrator may select this skill automatically."
        }
      },
      "additionalProperties": false
    },
    "PlanStep": {
      "type": "object",
      "required": ["tool", "description"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "Tool name to invoke."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What this step does."
        },
        "args_template": {
          "type": "object",
          "description": "Pre-filled arguments with optional {{variable}} placeholders."
        },
        "delegates": {
          "type": "string",
          "minLength": 1,
          "description": "Child skill to delegate to at this step. Must be listed in delegates_to."
        },
        "requires_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Evidence IDs that must be collected before this step's tool is allowed."
        }
      },
      "additionalProperties": false
    },
    "EvidenceItem": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "Machine-readable identifier (snake_case)."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What constitutes this evidence."
        }
      },
      "additionalProperties": false
    },
    "EvidenceDetectionRule": {
      "type": "object",
      "required": ["evidence_id", "tool_pattern"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID of the required evidence item this rule satisfies."
        },
        "tool_pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Regex matched against the tool name."
        },
        "result_pattern": {
          "type": "string",
          "description": "Optional regex searched against the stringified tool result."
        }
      },
      "additionalProperties": false
    },
    "InputSpec": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Placeholder name used as {{name}} in args_template."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What the value is, for the host or the user supplying it."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "If true, the skill cannot run without this value."
        },
        "pattern": {
          "type": "string",
          "description": "Python regex the whole value must match."
        }
      },
      "additionalProperties": false
    },
    "ReferencedContent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique name for this content block."
        },
        "path": {
          "type": "string",
          "description": "Relative path hint (e.g. ./queries)."
        },
        "content": {
          "type": "string",
          "description": "Inline Markdown content."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "If true, the agent must consult this block before finalizing."
        }
      },
      "additionalProperties": false
    }
  }
}
